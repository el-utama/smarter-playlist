  "components": {
    "comment_intro": {
      "type": "comment",
      "params": {
        "text": "__PLAYLIST_COMMENT__\n\nHow to use: duplicate this program, rename it, and adjust the pool URI, offsets, and ranges. Program name = playlist name. The first run creates the playlist; later runs replace it.",
        "style": "sticky",
        "color": "yellow",
        "size": "medium"
      },
      "sources": {}
    },
    "comment_priority": {
      "type": "comment",
      "params": {
        "text": "PRIORITY: 26-artist pool. AllButTheFirst = rotation offset. First = candidate count. MaxTracksPerArtist = per-artist limit.",
        "style": "simple",
        "color": "blue",
        "size": "small"
      },
      "sources": {}
    },
    "comment_global": {
      "type": "comment",
      "params": {
        "text": "GLOBAL: genre pool. AllButTheFirst = rotation offset. First = candidate count. MaxTracksPerArtist = global per-artist limit.",
        "style": "simple",
        "color": "green",
        "size": "small"
      },
      "sources": {}
    },
    "comment_rules": {
      "type": "comment",
      "params": {
        "text": "IMPORTANT: ShorterThan time=21600 (6 hours). match-max-run artist max_run=1 unbreakable (no consecutive artist). distribution source priority(60%) global(40%). Do not remove or change without understanding the effect.",
        "style": "simple",
        "color": "pink",
        "size": "small"
      },
      "sources": {}
    },
    "comment_run": {
      "type": "comment",
      "params": {
        "text": "HOW TO RUN: Preview first to check duration and order. When satisfied, Run to save. Pools must exist and their URIs must be filled. Internal pools do not need to be followed.",
        "style": "simple",
        "color": "gray",
        "size": "small"
      },
      "sources": {}
    },
    "priority_pool": {
